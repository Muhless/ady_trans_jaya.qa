{
  "name": "ady-trans-jaya-e2e",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pengujian E2E Ady Trans Jaya memakai Appium + WebdriverIO",
  "scripts": {
    "test": "wdio run ./wdio.conf.js",
    "test:smoke": "wdio run ./wdio.conf.js --spec ./test/smoke.spec.js",
    "test:register": "wdio run ./wdio.conf.js --spec ./test/register.spec.js",
    "test:login": "wdio run ./wdio.conf.js --spec ./test/login.spec.js",
    "appium": "appium --address 127.0.0.1 --port 4723",
    "doctor": "appium driver doctor uiautomator2",
    "emulator": "emulator -avd pixel_api36"
  },
  "devDependencies": {
    "@wdio/cli": "^9.19.2",
    "@wdio/local-runner": "^9.19.2",
    "@wdio/mocha-framework": "^9.19.2",
    "@wdio/spec-reporter": "^9.19.2",
    "webdriverio": "^9.19.2"
  }
}
