<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AdyTransJaya" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand_surface</item>
        <item name="android:statusBarColor">@color/brand_primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/brand_surface</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!-- Latar belakang jendela saat aplikasi baru dibuka, disamakan dengan
         warna atas splash screen supaya tidak ada kedipan putih. -->
    <style name="Theme.AdyTransJaya.Starting" parent="Theme.AdyTransJaya">
        <item name="android:windowBackground">@color/brand_primary_dark</item>
    </style>

</resources>
